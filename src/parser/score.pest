// ============================================
// 顶层规则：整个乐谱文件
// ============================================
file = { SOI ~ (content ~ NEWLINE?)* ~ EOI }
content = { 
    control |           // #开头的控制函数
    note |              // 音符
    chord |             // 花括号和弦
    tie |               // 圆括号连音线
    bracket |           // 方括号减时线
    dot |               // 附点
    octave_change |     // 幂号八度变化
    whitespace | 
    NEWLINE 
}

// ============================================
// 控制函数：#开头，尖括号传参
// ============================================
control = { "#" ~ ident ~ ("<" ~ param ~ ">")? }
param = { (control | note | chord | tie | bracket | ident | number | punctuation | whitespace)* }

// ============================================
// 音符：数字1-7，后面可跟修饰符
// ============================================
note = { 
    ASCII_DIGIT ~                    // 1-7
    octave_modifier? ~               // 八度修饰符（^+1, ^-1, ^=）
    duration_modifier?               // 时值修饰符（后面可扩展）
}
octave_modifier = { "^" ~ ("+" | "-" | "=") ~ ASCII_DIGIT? }
duration_modifier = { "." }          // 附点（单独处理）

// ============================================
// 幂号表达式：独立的八度变化指令
// ============================================
octave_change = { "^" ~ ("+" | "-" | "=") ~ ASCII_DIGIT? }

// ============================================
// 方括号：减时线（支持嵌套）
// ============================================
bracket = { "[" ~ bracket_inner+ ~ "]" }
bracket_inner = { bracket | note | chord | tie | dot | whitespace }

// ============================================
// 花括号：和弦（支持嵌套）
// ============================================
chord = { "{" ~ chord_inner+ ~ "}" }
chord_inner = { chord | note | bracket | tie | dot | whitespace }

// ============================================
// 圆括号：连音线
// ============================================
tie = { "(" ~ tie_inner+ ~ ")" }
tie_inner = { tie | note | chord | bracket | dot | whitespace }

// ============================================
// 附点
// ============================================
dot = { "." }

// ============================================
// 基础词法
// ============================================
ident = { ASCII_ALPHA ~ (ASCII_ALPHANUMERIC | "_")* }
number = { ASCII_DIGIT+ }
punctuation = { "," | ":" | ";" }

// ============================================
// 空白和换行
// ============================================
whitespace = { " " | "\t" }
NEWLINE = { "\n" | "\r\n" | "\r" }

// ============================================
// 忽略的空白（pest自动跳过）
// ============================================
WHITESPACE = _{ whitespace }